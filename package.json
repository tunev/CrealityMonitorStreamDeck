{
    "name": "com.tunev.crealitymonitor",
    "version": "1.0.0",
    "private": true,
    "description": "Stream Deck plugin that shows live status for Creality K-series 3D printers (K1, K1C, K1 Max).",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.tunev.crealitymonitor\""
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.10.1",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~24.1.0",
        "@types/ws": "^8.5.12",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^3.0.1",
        "ws": "^8.18.0"
    }
}
