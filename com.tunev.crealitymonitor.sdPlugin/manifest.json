{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Creality Monitor",
	"Version": "1.1.0.0",
	"Author": "Tunev",
	"Actions": [
		{
			"Name": "Print Status",
			"UUID": "com.tunev.crealitymonitor.status",
			"Icon": "imgs/actions/status/icon",
			"Tooltip": "Shows the live state, progress and remaining time of a Creality K-series printer (K1 / K1C / K1 Max).",
			"PropertyInspectorPath": "ui/status.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/status/key-idle",
					"TitleAlignment": "bottom",
					"FontSize": 13
				},
				{
					"Image": "imgs/actions/status/key-printing",
					"TitleAlignment": "bottom",
					"FontSize": 13
				},
				{
					"Image": "imgs/actions/status/key-paused",
					"TitleAlignment": "bottom",
					"FontSize": 13
				},
				{
					"Image": "imgs/actions/status/key-complete",
					"TitleAlignment": "bottom",
					"FontSize": 13
				},
				{
					"Image": "imgs/actions/status/key-error",
					"TitleAlignment": "bottom",
					"FontSize": 13
				},
				{
					"Image": "imgs/actions/status/key-offline",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			]
		},
		{
			"Name": "Nozzle Temp",
			"UUID": "com.tunev.crealitymonitor.nozzle",
			"Icon": "imgs/actions/nozzle/icon",
			"Tooltip": "Shows live nozzle temperature (current and target) of a Creality K-series printer (K1 / K1C / K1 Max).",
			"PropertyInspectorPath": "ui/nozzle.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/nozzle/key",
					"TitleAlignment": "middle",
					"FontSize": 13
				}
			]
		},
		{
			"Name": "Bed Temp",
			"UUID": "com.tunev.crealitymonitor.bed",
			"Icon": "imgs/actions/bed/icon",
			"Tooltip": "Shows live bed temperature (current and target) of a Creality K-series printer (K1 / K1C / K1 Max).",
			"PropertyInspectorPath": "ui/bed.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/bed/key",
					"TitleAlignment": "middle",
					"FontSize": 13
				}
			]
		},
		{
			"Name": "Fan Control",
			"UUID": "com.tunev.crealitymonitor.fan",
			"Icon": "imgs/actions/fan/icon",
			"Tooltip": "Turns the Model, Back or Side fan of a Creality K-series printer on or off.",
			"PropertyInspectorPath": "ui/fan.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/fan/key-off",
					"TitleAlignment": "bottom",
					"FontSize": 13
				},
				{
					"Image": "imgs/actions/fan/key-on",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			]
		},
		{
			"Name": "Camera",
			"UUID": "com.tunev.crealitymonitor.camera",
			"Icon": "imgs/actions/camera/icon",
			"Tooltip": "Shows a live WebRTC camera preview of a Creality K-series printer in the Property Inspector panel.",
			"PropertyInspectorPath": "ui/camera.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/camera/key",
					"TitleAlignment": "bottom",
					"FontSize": 13
				}
			]
		}
	],
	"Category": "Creality Monitor",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Live print status, temperature, cooling fan control and camera preview for Creality K1/K1C/K1 Max 3D printers. Monitor your printer directly on your Stream Deck and turn fans on/off with a single key press. Requires local network access to the printer (port 9999).",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"URL": "https://github.com/tunev/CrealityMonitorStreamDeck",
	"SupportURL": "https://github.com/tunev/CrealityMonitorStreamDeck/issues",
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"UUID": "com.tunev.crealitymonitor"
}